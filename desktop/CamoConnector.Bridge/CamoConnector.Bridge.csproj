<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>CoDStreamingTools.Bridge</AssemblyName>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="multiplayer-catalog.json" />
    <EmbeddedResource Include="multiplayer-catalog.json" LogicalName="CamoConnector.MultiplayerCatalog" />
    <EmbeddedResource Include="CamoArtwork/*.png" LogicalName="CamoConnector.CamoArtwork.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../CamoConnector/TrophyTracker/progress.js" LogicalName="CamoConnector.LocalUi.progress.js" />
    <EmbeddedResource Include="LocalUi/*" LogicalName="CamoConnector.LocalUi.%(Filename)%(Extension)" />
    <Content Include="../../special-catalog.json" Link="special-catalog.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
