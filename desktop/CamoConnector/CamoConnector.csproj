<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CoDStreamingTools</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Product>CoD Streaming Tools</Product>
    <ApplicationTitle>CoD Streaming Tools</ApplicationTitle>
    <ApplicationIcon>CamoConnector.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GameWindows.cs" Link="GameWindows.cs" />
    <EmbeddedResource Include="TrophyTracker/*" LogicalName="TrophyTracker.%(Filename)%(Extension)" />
    <EmbeddedResource Include="CamoConnector.ico" LogicalName="CamoConnector.AppIcon" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(CAMO_UPDATE_NOTIFY_URL)' != ''">
    <AssemblyMetadata Include="CamoUpdateNotifyUrl" Value="$(CAMO_UPDATE_NOTIFY_URL)" />
  </ItemGroup>
  <Import Project="../UpdateSources.props" />
</Project>
