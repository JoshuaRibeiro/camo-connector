<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CoDStreamingTools.Detector</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GameWindows.cs" Link="GameWindows.cs" />
    <EmbeddedResource Include="../CamoConnector.Bridge/multiplayer-catalog.json" LogicalName="CamoConnector.MultiplayerCatalog" />
    <EmbeddedResource Include="../../special-catalog.json" LogicalName="CamoConnector.Detector.SpecialCatalog" />
  </ItemGroup>
</Project>
