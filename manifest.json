{
  "manifest_version": 3,
  "name": "Camo Connector",
  "version": "1.9.63",
  "description": "Sync Call of Duty camo progress to the MW4 tracker using the local Camo Connector desktop app.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "Camo Connector", "default_popup": "pairing.html" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47150/*"],
  "optional_host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://mw4.darkmattersolutions.uk/*"],
    "js": ["tracker.js", "backup.js"]
  }]
}
